# Copy this file to .env and fill in the real values.
# .env itself is gitignored and must never be committed.

PORT=4000

# MongoDB Atlas. The name after the last slash is the database - leave it out
# and everything quietly goes into a database called "test".
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.example.invalid/shopngo?retryWrites=true&w=majority

# Signs the login tokens. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs everybody out, which is exactly what you want if it leaks.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# How long an emailed code stays usable.
OTP_TTL_MINUTES=10

# Where the shop lives, used for the links inside emails.
# In production this is the deployed frontend, e.g. https://shop-n-go.vercel.app
FRONTEND_URL=http://localhost:5173

# Which sites are allowed to call this API, comma separated. Leave it empty
# and any site can - fine locally, not fine once this is on the internet.
ALLOWED_ORIGINS=

# Order notifications go here as well as to the customer.
ADMIN_EMAIL=you@example.com

# Brevo sends over HTTPS instead of SMTP. Set this and the SMTP settings
# below are ignored. Needed on hosts that block outbound SMTP - Render's free
# tier does, so port 465 there simply never answers.
# Get one at brevo.com: SMTP & API > API keys. Verify your sender address
# under Senders first, or Brevo refuses the message.
BREVO_API_KEY=

# SMTP. Used when BREVO_API_KEY is empty. For Gmail this is NOT your password
# - turn on 2-Step Verification and create an App Password. Port 465 is TLS
# from the start, 587 upgrades to it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM=ShopNGo <you@example.com>

# 1 prints emails to the terminal instead of sending them. Handy for testing,
# and what happens automatically when there are no SMTP credentials at all.
MAIL_DRY_RUN=0
